<!doctype html>
<html lang="en" data-resolution="portrait">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1080, height=1920" />
    <!-- Generated by scripts/build.py from job.json — edit job.json and rebuild, not this file. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@500;700;900&display=swap" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 1080px; height: 1920px; overflow: hidden; background: #000; }
      :root { --yellow: #fec529; --orange: #f89b1d; --navy: #1a2b48; }
      #root { position: relative; width: 100%; height: 100%; overflow: hidden; background: #000; font-family: Roboto, sans-serif; color: #fff; }
      .shot { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
      .overlay { position: absolute; inset: 0; z-index: 100; }
      .soft { text-shadow: 0 2px 10px rgba(0,0,0,.5), 0 0 3px rgba(0,0,0,.35); }
      .y { color: var(--yellow); }
      .top-shade { position: absolute; left: 0; right: 0; top: 0; height: 900px; background: linear-gradient(180deg, rgba(0,0,0,.5), rgba(0,0,0,.28) 55%, rgba(0,0,0,0)); }
      .bot-shade { position: absolute; left: 0; right: 0; top: 1150px; height: 470px; background: linear-gradient(180deg, rgba(0,0,0,0), rgba(0,0,0,.32) 50%, rgba(0,0,0,0)); }

      /* hook */
      .mid-shade { position: absolute; left: 0; right: 0; top: 560px; height: 860px; background: radial-gradient(ellipse 75% 50% at 50% 50%, rgba(0,0,0,.42), rgba(0,0,0,0)); }
      .hook { position: absolute; left: 64px; right: 64px; top: 640px; display: flex; flex-direction: column; align-items: center; text-align: center; }
      .h-kicker { font-weight: 700; font-size: 44px; letter-spacing: 4px; }
      .h-big { margin-top: 18px; font-weight: 900; font-size: 104px; line-height: 1.02; white-space: nowrap; }
      .h-sub { position: absolute; top: 210px; left: 0; right: 0; margin: 0 auto; width: max-content; padding: 14px 30px; border-radius: 16px; background: rgba(26,43,72,.85); font-weight: 700; font-size: 44px; white-space: nowrap; }
      .h-sub.alt { background: var(--yellow); color: var(--navy); }

      /* title */
      .title { position: absolute; left: 64px; right: 64px; top: 720px; display: flex; flex-direction: column; align-items: center; text-align: center; }
      .t-logo img { display: block; height: 120px; filter: drop-shadow(0 2px 8px rgba(0,0,0,.5)); }
      .t-num { margin-top: 26px; font-weight: 900; font-size: 156px; line-height: .95; color: var(--yellow); white-space: nowrap; }
      .t-in { font-weight: 900; font-size: 84px; letter-spacing: 10px; white-space: nowrap; }
      .t-sub { margin-top: 16px; font-weight: 500; font-size: 46px; white-space: nowrap; }
      .t-route { margin-top: 26px; padding: 12px 26px; border-radius: 999px; background: rgba(26,43,72,.85); border: 2px solid var(--yellow); font-weight: 700; font-size: 27px; letter-spacing: 1px; white-space: nowrap; }

      /* progress */
      .prog { position: absolute; left: 64px; right: 64px; top: 226px; display: flex; align-items: center; gap: 22px; }
      .prog-lab { font-weight: 700; font-size: 24px; letter-spacing: 3px; white-space: nowrap; }
      .cells { flex: 1; display: flex; gap: 8px; }
      .cell { flex: 1; height: 12px; border-radius: 6px; background: rgba(255,255,255,.3); overflow: hidden; }
      .fill { width: 100%; height: 100%; background: var(--yellow); }

      /* day card */
      .dcard { position: absolute; left: 64px; top: 300px; width: 580px; }
      .d-trans { display: inline-flex; align-items: center; gap: 12px; margin-bottom: 18px; padding: 9px 20px 9px 14px; border-radius: 999px; background: rgba(26,43,72,.85); font-weight: 700; font-size: 30px; }
      .ico { width: 36px; height: 36px; fill: none; stroke: var(--yellow); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      .d-pill { display: block; width: max-content; padding: 9px 20px 10px; border-radius: 10px; background: var(--yellow); color: var(--navy); font-weight: 900; font-size: 40px; letter-spacing: 1px; box-shadow: 0 6px 16px rgba(0,0,0,.25); }
      .d-place { margin-top: 12px; font-weight: 900; font-size: 78px; line-height: 1; letter-spacing: 1px; }
      .d-acts { margin-top: 20px; display: flex; flex-direction: column; gap: 10px; }
      .d-act { display: flex; align-items: center; gap: 14px; font-weight: 500; font-size: 38px; white-space: nowrap; }
      .bul { width: 12px; height: 12px; border-radius: 50%; background: var(--yellow); box-shadow: 0 1px 4px rgba(0,0,0,.4); }

      /* map */
      .map { position: absolute; right: 40px; top: 290px; }
      .map-svg { display: block; overflow: visible; }
      .land { fill: rgba(255,255,255,.2); stroke: rgba(255,255,255,.6); stroke-width: 1.5; stroke-linejoin: round; }
      .route-ghost { fill: none; stroke: rgba(255,255,255,.35); stroke-width: 2; stroke-dasharray: 4 6; }
      .route { fill: none; stroke: var(--yellow); stroke-width: 4; stroke-linecap: round; stroke-dasharray: 1; }
      .dot { fill: #fff; stroke: var(--navy); stroke-width: 2; }
      .dot-on { fill: var(--yellow); stroke: #fff; stroke-width: 3; }
      .isle { fill: rgba(255,255,255,.75); stroke: rgba(255,255,255,.9); stroke-width: .8; }
      .lab { fill: #fff; font-weight: 700; font-size: 21px; paint-order: stroke; stroke: rgba(0,0,0,.55); stroke-width: 4px; }

      /* plan + inclusions */
      .plan { position: absolute; left: 64px; right: 64px; top: 700px; text-align: center; }
      .p-q { font-weight: 900; font-size: 74px; line-height: 1.08; }
      .incl { position: absolute; left: 64px; right: 64px; top: 250px; padding: 32px 44px 36px; border-radius: 28px; background: rgba(26,43,72,.88); box-shadow: 0 16px 40px rgba(0,0,0,.35); }
      .i-head { font-weight: 900; font-size: 44px; color: var(--yellow); letter-spacing: 1px; margin-bottom: 14px; white-space: nowrap; }
      .i-row { display: flex; align-items: center; gap: 18px; font-weight: 700; font-size: 40px; padding: 7px 0; white-space: nowrap; }
      .tick { width: 50px; height: 50px; border-radius: 50%; background: var(--yellow); display: flex; align-items: center; justify-content: center; flex: none; }
      .tick svg { width: 30px; height: 30px; stroke: var(--navy); stroke-width: 4; fill: none; }

      /* captions */
      .cap { position: absolute; left: 90px; right: 90px; top: 1330px; text-align: center; font-weight: 700; font-size: 52px; line-height: 1.22; text-wrap: balance; }

      /* end card */
      .end-shade { position: absolute; inset: 0; background: rgba(26,43,72,.8); }
      .end-inner { position: absolute; left: 64px; right: 64px; top: 520px; display: flex; flex-direction: column; align-items: center; text-align: center; }
      .end-logo img { display: block; height: 200px; filter: drop-shadow(0 4px 14px rgba(0,0,0,.4)); }
      .end-title { margin-top: 60px; font-weight: 900; font-size: 60px; white-space: nowrap; }
      .end-web { margin-top: 36px; font-weight: 900; font-size: 80px; color: var(--yellow); white-space: nowrap; }
      .end-wa { margin-top: 34px; display: flex; align-items: center; gap: 18px; padding: 18px 36px; border-radius: 999px; background: #128c7e; font-weight: 700; font-size: 52px; white-space: nowrap; box-shadow: 0 10px 28px rgba(0,0,0,.3); }
      .end-wa svg { width: 60px; height: 60px; fill: #fff; }
      .end-link { margin-top: 70px; font-weight: 700; font-size: 44px; letter-spacing: 2px; }
      .arrow { display: inline-block; color: var(--yellow); }
        </style>
  </head>
  <body>
    <div
      id="root"
      data-composition-id="main"
      data-start="0"
      data-duration="%END%"
      data-width="1080"
      data-height="1920"
    >
      %BODY%
    </div>
    <script>
      const tl = gsap.timeline({ paused: true });
      %JS%
      window.__timelines = window.__timelines || {};
      window.__timelines["main"] = tl;
    </script>
  </body>
</html>
